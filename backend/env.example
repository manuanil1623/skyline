# =====================================================================
# BEAUTY PARLOR APP — ENVIRONMENT VARIABLES
# Copy this file to backend/.env and replace every placeholder below.
# Do NOT commit the filled-in .env file to git.
# =====================================================================

# --- Supabase ---
# Find these at: Supabase Dashboard → your project → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Project URL" on that page — starts with https:// and ends in .supabase.co

SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Click "reveal" next to "service_role" key on that page.
# BACKEND ONLY. Never put this in a NEXT_PUBLIC_ variable or send it to the browser —
# it bypasses Row Level Security entirely.

SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# The "anon public" key on the same page. Safe to expose to the frontend.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Same value as SUPABASE_URL above — the frontend needs its own copy with this prefix.

NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Same value as SUPABASE_ANON_KEY above.

# --- Backend API ---
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Change this to your deployed backend URL once you host it (Render, Railway, etc.)

# --- Salon UPI details (used to build the dynamic QR payload) ---
SALON_UPI_VPA=yoursalon@okhdfcbank
# Your real UPI ID (from your bank / payment app). Any value works for testing —
# the QR will just point to a fake VPA until you put your real one in.

SALON_PAYEE_NAME=Your Salon Name

# --- Payment gateway webhook secret (only needed if you wire up auto-verification) ---
PAYMENT_GATEWAY_WEBHOOK_SECRET=
# Leave blank until you sign up with a gateway (Razorpay, Cashfree, PhonePe PG, etc.)
# and set up their webhook. Manual "Confirm Payment" works fine without this.
