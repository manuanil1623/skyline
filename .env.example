# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key       # backend only, never expose to frontend
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Backend API ---
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Salon UPI details (used to build the dynamic QR payload) ---
SALON_UPI_VPA=skylinebeauty@okhdfcbank
SALON_PAYEE_NAME=Skyline Beauty Parlour

# --- Payment gateway webhook secret (if using Razorpay/Cashfree/etc.) ---
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-webhook-secret
